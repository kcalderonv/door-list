      "css": ".ds-card{display:flex;flex-direction:column;gap:var(--space-4);min-width:0;padding:var(--space-6);background:var(--color-surface);color:var(--color-text);border:var(--border-width) solid var(--color-border);border-radius:var(--radius-card);box-shadow:var(--shadow-card);font-family:var(--font-body);line-height:var(--leading-body)}.ds-selected{border-color:var(--color-focus);outline:var(--border-width) solid var(--color-focus)}.ds-card-title{margin:0;overflow-wrap:anywhere;font-family:var(--font-body);font-size:var(--text-card-title);font-weight:var(--weight-strong);line-height:var(--leading-heading)}.ds-card-meta{margin:0;overflow-wrap:anywhere;color:var(--color-text-muted);font-size:var(--text-small)}"
