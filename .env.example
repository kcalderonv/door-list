NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=

# Email: enable after filling in the sender and credentials.
MAIL_ENABLED=true
# Empty = Mailtrap in development, SMTP in production. Overrides: mailtrap | smtp.
MAIL_TRANSPORT=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Door List"
# Public origin used in private ticket links (HTTPS required in production).
APP_URL=http://localhost:3000

# Development: Mailtrap Email Sandbox > Integration > SMTP.
MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_SECURE=false
MAILTRAP_SMTP_REQUIRE_TLS=true
MAILTRAP_SMTP_USER=88177eb789c414
MAILTRAP_SMTP_PASSWORD=cb49f457b00c29

# Production: local SMTP relay (change these if using another SMTP provider).
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
